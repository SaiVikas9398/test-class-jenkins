pipeline {
    agent any
    stages {
        stage('Checkout Code') {
            steps {
                echo 'Successfully pulled code from GitHub via webhook!'
            }
        }
        stage('Run a Build Step') {
            steps {
                sh 'echo "Running build commands on EC2 instance..."'
                sh 'uname -a'
            }
        }
    }
}

#test Triger

post {
        success {
            echo 'SUCCESS! The build finished with flying colors.'
        }
        failure {
            echo 'FAILURE! Something went wrong in the build.'
        }
        always {
            echo 'This runs no matter what happens, success or failure!'
        }
    }
